{
  "name": "compaction-watch",
  "version": "1.0.0",
  "description": "Counts automatic session compactions and provides local alerts.",
  "author": {
    "name": "Julian Gomez"
  },
  "license": "MIT",
  "keywords": ["compaction", "context", "alerts"],
  "skills": "./skills/",
  "interface": {
    "displayName": "Compaction Watch",
    "shortDescription": "Local compaction alerts"
  },
  "hooks": [
    {
      "event": "PreCompact",
      "matcher": "auto",
      "command": "node ./bin/compaction-watch.mjs count --host kimi",
      "timeout": 10
    },
    {
      "event": "PostCompact",
      "matcher": "auto",
      "command": "node ./bin/compaction-watch.mjs notify --host kimi",
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": "node ./bin/compaction-watch.mjs notify --repeat --host kimi",
      "timeout": 10
    },
    {
      "event": "SessionStart",
      "command": "node ./bin/compaction-watch.mjs prune --host kimi",
      "timeout": 10
    }
  ]
}
